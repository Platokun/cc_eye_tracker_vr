# ============================================================================
#  cc_eye_tracker_vr  -  USER SETTINGS
#
#  Edit the values on the right of the "=" signs, save the file, then build.
#  Anything after a # is a comment and is ignored.
#  Do NOT put spaces around the "=".
#
#  After editing run:   build_and_flash.bat      (Windows)
#                       ./build_and_flash.sh     (Linux / macOS)
# ============================================================================


# ----------------------------------------------------------------------------
# 1. HER HOME WIFI
#    The tracker joins this network automatically when it powers on.
#    Leave blank if you do not want it to connect to anything yet.
# ----------------------------------------------------------------------------

WIFI_SSID=
WIFI_PASSWORD=


# ----------------------------------------------------------------------------
# 2. THE TRACKER'S OWN WIFI (fallback access point)
#    If the tracker cannot join the wifi above, it creates this network so you
#    can still reach it from a phone or laptop and fix the settings.
#    These are the firmware defaults - change them if you like.
# ----------------------------------------------------------------------------

AP_SSID=EyeTrackVR
AP_PASSWORD=12345678


# ----------------------------------------------------------------------------
# 3. DEVICE NAME (optional)
#    The name the tracker uses on the network (mDNS) and in the eye tracking
#    app. Only letters, numbers and dashes. Leave blank to keep the default.
# ----------------------------------------------------------------------------

DEVICE_NAME=cc_eyetracker
