### cc_eye_tracker_vr additions ###

# CONTAINS HER WIFI PASSWORD - generated from user_board.nzk.config.
# Never commit this.
boards/generated/

# Build output. The merged image may have Wi-Fi credentials compiled into it
# and is produced by build.sh / build.bat (or by CI, which uploads it as an
# artifact). Never commit it.
out/*
!out/.gitkeep
*.bin

# Stale build trees moved aside by build.sh / build.bat
build.stale.*

